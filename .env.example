VITE_GOOGLE_CLIENT_ID=

# Server-side only (no VITE_ prefix — never exposed to the browser)
GOOGLE_CLIENT_ID=
# Same OAuth client's secret — used to exchange/refresh Google Calendar tokens server-side
# (see api/googleOAuth*.ts). Required for Calendar sync; not needed for sign-in alone.
GOOGLE_CLIENT_SECRET=
# Comma-separated list of Google account emails allowed to sign in
ALLOWED_EMAILS=
# Random secret used to sign app session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set automatically when you connect the Upstash Redis integration to this
# project (Vercel dashboard → Storage → Create Database).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Powers the AI scheduling agent (api/agent.ts). Server-side only.
ANTHROPIC_API_KEY=

# Spotify app credentials (see api/spotify*.ts) — used for now-playing/playback control and the
# in-tab player on the Pomodoro page. Create an app at developer.spotify.com/dashboard and add
# "<your-deployment-origin>/api/spotifyOAuthCallback" (and the same for localhost) as a Redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Schoology's personal API (see api/_lib/schoologyApi.ts) — only needed if you want
# points possible / full descriptions from Schoology instead of just the .ics feed's due dates.
# Create an app-level consumer key/secret at https://app.schoology.com/api, then each user pastes
# their own personal API key/secret in Settings → School. Canvas and Google Classroom need no
# server-side app credentials — Canvas uses a per-user personal access token, and Classroom reuses
# the Google OAuth client above (just add the classroom.coursework.me.readonly scope, already
# wired into api/_lib/googleOAuth.ts).
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
