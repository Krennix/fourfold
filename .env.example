VITE_GOOGLE_CLIENT_ID=

# Server-side only (no VITE_ prefix — never exposed to the browser)
GOOGLE_CLIENT_ID=
# Same OAuth client's secret — used to exchange/refresh Google Calendar tokens server-side
# (see api/googleOAuth*.ts). Required for Calendar sync; not needed for sign-in alone.
GOOGLE_CLIENT_SECRET=
# Comma-separated list of Google account emails allowed to sign in
ALLOWED_EMAILS=
# Random secret used to sign app session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set automatically when you connect the Upstash Redis integration to this
# project (Vercel dashboard → Storage → Create Database).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Powers the AI scheduling agent (api/agent.ts). Server-side only.
ANTHROPIC_API_KEY=
