{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/api/googleOAuthStart",
      "destination": "/api/google?action=oauthStart"
    },
    {
      "source": "/api/googleOAuthCallback",
      "destination": "/api/google?action=oauthCallback"
    },
    {
      "source": "/api/googleAccessToken",
      "destination": "/api/google?action=accessToken"
    },
    {
      "source": "/api/googleCalendars",
      "destination": "/api/google?action=calendars"
    },
    {
      "source": "/api/googleIcsFeed",
      "destination": "/api/google?action=icsFeed"
    },
    {
      "source": "/api/spotifyOAuthStart",
      "destination": "/api/spotify?action=oauthStart"
    },
    {
      "source": "/api/spotifyOAuthCallback",
      "destination": "/api/spotify?action=oauthCallback"
    },
    {
      "source": "/api/spotifyAccessToken",
      "destination": "/api/spotify?action=accessToken"
    },
    {
      "source": "/api/spotifyAccount",
      "destination": "/api/spotify?action=account"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?action=metadata"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth?action=register"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth?action=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth?action=token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
